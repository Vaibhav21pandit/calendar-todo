{
  "name": "calendar-todo",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:pages": "wrangler pages dev dist --local --d1 DB=calendar-todo-db --port 8788 --ip 127.0.0.1",
    "dev:all": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"wrangler pages dev dist --local --d1 DB=calendar-todo-db --port 8788 --ip 127.0.0.1\"",
    "deploy": "vite build && wrangler pages deploy dist --project-name calendar-todo",
    "deploy:preview": "vite build && wrangler pages deploy dist --project-name calendar-todo --branch preview",
    "d1:create": "wrangler d1 create calendar-todo-db",
    "d1:migrate:local": "wrangler d1 execute calendar-todo-db --local --file=migrations/0001_create_todos.sql",
    "d1:migrate:remote": "wrangler d1 execute calendar-todo-db --remote --file=migrations/0001_create_todos.sql"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^24.1.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^1.6.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "hono": "^4.13.5",
    "idb": "^7.1.1"
  }
}
